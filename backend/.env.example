# Database (PostgreSQL - required for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/iso9001_audit?schema=public"

# For local development with SQLite (not recommended for production):
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
# Comma-separated list of ALLOWED origins. Must be exact-match (no wildcards).
# Keep this in sync with every domain that serves the frontend.
# The frontend is served same-origin under /_/backend/api, so a stale absolute
# NEXT_PUBLIC_API_URL would hit CORS here. List all real origins:
CORS_ORIGIN=http://localhost:3000,https://www.normetta.com,https://normetta.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"

# AI (root cause analysis agent)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
